# Supabase (Dashboard → Project Settings → API). The URL and publishable key are browser-safe:
# row level security protects the data. Local values come from `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Public site address, used in auth emails and links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Salt for hashing visitor IP + user agent into a rate-limit fingerprint.
RATE_LIMIT_SALT=change-me

# Server-only, optional. Lets /api/jobs/notifications claim the notification outbox.
# Without it, notifications stay queued (enquiries are never lost) until a job runner is set up.
SUPABASE_SECRET_KEY=
JOBS_TOKEN=

# Optional. Transactional email for notifications (Resend). Without it, the job marks them skipped.
RESEND_API_KEY=
NOTIFICATIONS_FROM=Brexoo <notifications@example.com>
